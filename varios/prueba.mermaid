---
config:
  theme: 'base'
  themeVariables:
    primaryColor: '#6df4da'
    primaryTextColor: '#000000'
    lineColor: '#7e7e7e'
    secondaryColor: '#006100'
    tertiaryColor: '#ffffff'
---

flowchart TD

    subgraph F0[0. Ingreso de Datos]
        A1[Imágenes originales]
        A2[CSV Metadata original]
    end

    subgraph F2[1. Análisis Exploratorio]
        B1[Validación de estructura]
        B2[Análisis de consistencia]
        B3[Detección de errores]
        B4[Generación de Informe]
    end

    subgraph F3[2. Correcciones]
        C1[Corrección CSV]
        C2[Normalización nombres archivos]
        C3[Reorganización carpetas]
    end

    subgraph F4[3. Procesamiento de Imágenes]
        D1[Corte vertical / horizontal]
        D2[Generación mitades]
        D3[Clasificación por clase]
        D4[Dataset procesado]
    end

    subgraph F5[4. Dataset Listo para ML]
        E1[CSV limpio y consistente]
        E2[Imágenes procesadas]
        E3[Split train / val / test]
        E4[Datos listos para entrenamiento]
    end

    %% Flujo principal
    A1 --> B1
    A2 --> B1
    B4 --> C1
    C1 --> D1
    D4 --> E1
    D4 --> E2
    E2 --> E3
    E3 --> E4

    %% Retroalimentación
    B3 --> C1
    C2 --> B1