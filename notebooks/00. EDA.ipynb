    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"total_png = 0\\n\",\n",
    "    \"conteo_png: dict[str, int] = dict()\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ruta_ubicacion in PATHS.DATA_ORIGINALES.iterdir():\\n\",\n",
    "    \"    if ruta_ubicacion.is_dir():\\n\",\n",
    "    \"        pngs = list(ruta_ubicacion.glob(\\\"*.png\\\"))\\n\",\n",
    "    \"        conteo_png[ruta_ubicacion.name] = len(pngs)\\n\",\n",
    "    \"        total_png += len(pngs)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Total de perfiles: {total_png}\\\")\\n\",\n",
    "    \"print(conteo_png)\\n\",\n",
    "    \"\\n\",\n",
    "    \"report.add_metric(\\\"total_perfiles\\\", total_png)\\n\",\n",
    "    \"report.add_metric(\\\"perfiles_por_ubicacion\\\", conteo_png)\"\n",
